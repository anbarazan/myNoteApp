# Firebase CLI login selects a project but does not provide Admin SDK credentials.
# Set this project ID for local development.
FIREBASE_PROJECT_ID=myapp-a9601

# Recommended: point to a service-account JSON file outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Alternative: put the minified service-account JSON here instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

PORT=3000
